# Copy to .env and fill in. .env must NEVER be committed.
PORTAL_URL=https://portalacesso.redelojacorr.com.br/login
PORTAL_EMAIL=
PORTAL_SENHA=

# false = opens a visible browser (handy for development)
HEADLESS=false
# Folder where the CLI saves PDFs and error screenshots
DOWNLOAD_DIR=downloads

# API
PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 to expose it on the network (behind the HTTPS reverse proxy).
HOST=127.0.0.1

# Path prefix added by the reverse proxy in front of the API (Docker/VPS: /broker). Used only in links
# returned by the API (e.g. "pdf": "/broker/protocolos/123/pdf"). Empty when called directly.
PREFIXO_PUBLICO=

# PostgreSQL (see the root docker-compose.yml / .env). Holds API keys, logs and download history.
DATABASE_URL=postgres://vetornorte:change-me@127.0.0.1:5432/vetornorte

# Rate limit per API key (fixed 1-minute window, in memory). false = disabled.
RATE_LIMIT_HABILITADO=true
# Requests per minute for keys without their own limit (set per key with --limite).
RATE_LIMIT_POR_MINUTO=60

# Delivery destinations for POST /protocolos/<n>/pdf/envios (optional, as many as you want).
# Each DESTINO_<NAME>_URL creates a webhook destination called "<name>" (lowercase).
# The PDF is POSTed as JSON (base64). URLs are fixed here on purpose: callers can only pick a name.
# DESTINO_N8N_URL=https://n8n.example.com/webhook/pdf-proposta
# DESTINO_N8N_TOKEN=             # optional, sent as "Authorization: Bearer <token>"
# DESTINO_N8N_TIMEOUT_MS=15000   # optional
# DESTINO_WHATSAPP_URL=https://my-whatsapp-gateway.example.com/hooks/pdf

# LGPD retention (days). Older error logs / PDF download history rows are deleted daily.
RETENCAO_LOGS_DIAS=90
RETENCAO_DOWNLOADS_DIAS=365
RETENCAO_CONSULTAS_DIAS=90

# Secret for the CPF hash in the protocol query history (min. 32 chars; `openssl rand -hex 32`).
# MUST be the same value in dashboard/.env (the dashboard searches by this hash). In Docker it comes from the
# root .env. Changing it makes older history rows unsearchable by CPF (they still show the masked CPF).
CPF_HMAC_CHAVE=

# Portal session keep-alive: after this many idle minutes, the API reloads the Broker dashboard
# (light navigation) so the session does not expire, re-logging in if needed. false = disabled.
KEEPALIVE_HABILITADO=true
KEEPALIVE_INTERVALO_MINUTOS=10
