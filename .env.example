# Copy to .env and fill in. .env must NEVER be committed.
PORTAL_URL=https://portalacesso.redelojacorr.com.br/login
PORTAL_EMAIL=
PORTAL_SENHA=

# false = opens a visible browser (handy for development)
HEADLESS=false
# Folder where the CLI saves PDFs and error screenshots
DOWNLOAD_DIR=downloads

# API
PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 to expose it on the network (careful: the API has no authentication).
HOST=127.0.0.1
