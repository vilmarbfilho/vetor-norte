# Root environment for docker-compose. Copy to .env and fill in. .env must NEVER be committed.

# PostgreSQL (shared by API and dashboard).
# Use only URL-safe characters in the password (letters, digits, - _ .): it is embedded in connection URLs.
POSTGRES_USER=vetornorte
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vetornorte
# Host port (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# ---- VPS / Docker deployment (see deploy/README.md) ----

# Starts api, dashboard, caddy and backup with `docker compose up -d`. Leave unset on a dev machine.
# COMPOSE_PROFILES=producao

# Public domain (DNS A record -> VPS public IP). API at https://<domain>/broker, dashboard at https://<domain>/.
DOMINIO=vn.vlabs.com.br

# Secret for CPF hashes in the protocol query history (min. 32 chars): openssl rand -hex 32
# Given to both api and dashboard. Never change it after go-live: older rows become unsearchable by CPF.
CPF_HMAC_CHAVE=

# Daily database backup into ./backups (only on this server). true = enabled.
BACKUP_HABILITADO=false
BACKUP_HORA=03:00
BACKUP_MANTER=7
TZ=America/Sao_Paulo
