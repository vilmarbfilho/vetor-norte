# Copy to .env and fill in. .env must NEVER be committed.

# PostgreSQL (same database as the API; see the root docker-compose.yml / .env).
DATABASE_URL=postgres://vetornorte:change-me@127.0.0.1:5432/vetornorte

# Dashboard HTTP server. 127.0.0.1 = this machine only (in production, Caddy is in front).
PORT=3100
HOST=127.0.0.1

# Session cookie "Secure" flag (sent only over HTTPS). Keep true in production.
# Set false only for local development over http if your browser refuses Secure cookies on localhost (e.g. Safari).
COOKIE_SECURE=true

# Session expiry: idle timeout (hours) and absolute maximum (days).
SESSAO_INATIVIDADE_HORAS=8
SESSAO_DURACAO_MAXIMA_DIAS=7

# Login brute-force protection: wrong passwords per e-mail before blocking, and block duration.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Secret for CPF hashes in the protocol query history: MUST be the same value as CPF_HMAC_CHAVE in api/.env
# (min. 32 chars; openssl rand -hex 32). In Docker it comes from the root .env.
CPF_HMAC_CHAVE=

# Key that encrypts the users' Broker portal passwords: MUST be the same value as CREDENCIAIS_CHAVE in api/.env
# (32 random bytes: openssl rand -base64 32). In Docker it comes from the root .env.
CREDENCIAIS_CHAVE=
